# MeluXina training image: mirrors the Modal image's training stack (scripts/modal_coatnet_d96.py: python 3.11,
# torch 2.5.1, timm 1.0.29, numpy) + offline pretrained weights (compute nodes: assume no internet).
FROM docker.io/library/python:3.11-slim
RUN pip install --no-cache-dir torch==2.5.1 torchvision==0.20.1 timm==1.0.29 numpy safetensors==0.6.2 huggingface_hub==0.35.3
ENV HF_HOME=/opt/hf
RUN python -c "import timm; m = timm.create_model('resnet50.tv_in1k', pretrained=True); print('weights ok', sum(p.numel() for p in m.parameters()))" \
 && chmod -R a+rX /opt/hf
ENV HF_HUB_OFFLINE=1 OMP_NUM_THREADS=1 PYTHONUNBUFFERED=1
